<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.Circle?>

<?import java.net.URL?>
<ScrollPane fx:id="scrollPane" fitToWidth="true" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.project.hospitalmanagementsystem.controller.hospital.WantToKnowMore">
    <VBox alignment="TOP_CENTER" spacing="40" styleClass="main-container">
        <VBox.margin>
            <Insets top="50.0"/>
        </VBox.margin>

        <stylesheets>
            <URL value="@../../css/wanttoknowmore.css"/>
        </stylesheets>

        <!-- Page Title -->
        <Label text="Want to Know More" styleClass="page-title"/>

        <!-- Our Story Section -->
        <VBox spacing="15" alignment="CENTER">
            <Label text="🛤 Our Story" styleClass="section-heading"/>
            <Label text="Our journey began with a mission to deliver quality healthcare with compassion and innovation. Every step we take is driven by empathy and a commitment to excellence."
                   wrapText="true" styleClass="section-text" maxWidth="700"/>
        </VBox>

        <Line startX="0" endX="700" styleClass="section-line"/>

        <!-- Mission Section -->
        <VBox spacing="15" alignment="CENTER">
            <Label text="🎯 Mission" styleClass="section-heading"/>
            <Label text="We aim to provide outstanding service to every patient, blending modern medical technology with a personalized approach."
                   wrapText="true" styleClass="section-text" maxWidth="700"/>
        </VBox>

        <Line startX="0" endX="700" styleClass="section-line"/>

        <!-- Achievements Section -->
        <VBox spacing="15" alignment="CENTER">
            <Label text="🏆 Achievements" styleClass="section-heading"/>
            <FlowPane hgap="25" vgap="25" alignment="CENTER">
                <Button text="10 Clinics Opened" styleClass="milestone-button"/>
                <Button text="50K Patients Served" styleClass="milestone-button"/>
                <Button text="Top Healthcare Award 2025" styleClass="milestone-button"/>
            </FlowPane>
        </VBox>

        <Line startX="0" endX="700" styleClass="section-line"/>

        <!-- Location Section -->
        <VBox spacing="10" alignment="CENTER">
            <Label text="📍 Location" styleClass="section-heading"/>
            <Label text="Main Office: 123 Health St, Wellness City." wrapText="true" styleClass="section-text" maxWidth="700"/>
        </VBox>

        <Line startX="0" endX="700" styleClass="section-line"/>

        <!-- Testimonials Section -->
        <VBox spacing="30" alignment="CENTER">
            <Label text="🗣 Testimonials" styleClass="section-heading"/>
            <FlowPane hgap="20" vgap="20" alignment="CENTER">
                <!-- Testimonial Card -->
                <VBox spacing="10" alignment="CENTER" styleClass="testimonial-card" maxWidth="300">
                    <ImageView fitWidth="60" fitHeight="60" preserveRatio="true">
                        <image>
                            <Image url="https://via.placeholder.com/60"/>
                        </image>
                    </ImageView>
                    <Label text="Customer 1: This place changed my life!" wrapText="true" styleClass="testimonial-text"/>
                </VBox>
                <VBox spacing="10" alignment="CENTER" styleClass="testimonial-card" maxWidth="300">
                    <ImageView fitWidth="60" fitHeight="60" preserveRatio="true">
                        <image>
                            <Image url="https://via.placeholder.com/60"/>
                        </image>
                    </ImageView>
                    <Label text="Customer 2: Amazing staff and care." wrapText="true" styleClass="testimonial-text"/>
                </VBox>
                <VBox spacing="10" alignment="CENTER" styleClass="testimonial-card" maxWidth="300">
                    <ImageView fitWidth="60" fitHeight="60" preserveRatio="true">
                        <image>
                            <Image url="https://via.placeholder.com/60"/>
                        </image>
                    </ImageView>
                    <Label text="Customer 3: Quick and reliable services." wrapText="true" styleClass="testimonial-text"/>
                </VBox>
                <VBox spacing="10" alignment="CENTER" styleClass="testimonial-card" maxWidth="300">
                    <ImageView fitWidth="60" fitHeight="60" preserveRatio="true">
                        <image>
                            <Image url="https://via.placeholder.com/60"/>
                        </image>
                    </ImageView>
                    <Label text="Customer 4: Highly recommend to everyone!" wrapText="true" styleClass="testimonial-text"/>
                </VBox>
            </FlowPane>
        </VBox>

        <Line startX="0" endX="700" styleClass="section-line"/>

        <!-- Founders Section -->
        <VBox spacing="15" alignment="CENTER">
            <Label text="👥 Founders" styleClass="section-heading"/>
            <FlowPane hgap="25" vgap="25" alignment="CENTER">
                <!-- Founder Card -->
                <VBox spacing="5" alignment="CENTER">
                    <ImageView fitWidth="80" fitHeight="80" preserveRatio="true" styleClass="profile-pic">
                        <image>
                            <Image url="https://via.placeholder.com/80"/>
                        </image>
                    </ImageView>
                    <Label text="Dr. Mycah James" styleClass="section-text"/>
                    <Label text="CEO &amp; Founder" styleClass="subsection-text"/>
                </VBox>
                <VBox spacing="5" alignment="CENTER">
                    <ImageView fitWidth="80" fitHeight="80" preserveRatio="true" styleClass="profile-pic">
                        <image>
                            <Image url="https://via.placeholder.com/80"/>
                        </image>
                    </ImageView>
                    <Label text="Dr. Ayra Stark" styleClass="section-text"/>
                    <Label text="CTO &amp; Co-Founder" styleClass="subsection-text"/>
                </VBox>
                <VBox spacing="5" alignment="CENTER">
                    <ImageView fitWidth="80" fitHeight="80" preserveRatio="true" styleClass="profile-pic">
                        <image>
                            <Image url="https://via.placeholder.com/80"/>
                        </image>
                    </ImageView>
                    <Label text="Dr. Braun BlackWaters" styleClass="section-text"/>
                    <Label text="COO &amp; Co-Founder" styleClass="subsection-text"/>
                </VBox>
            </FlowPane>
        </VBox>

        <!-- Footer -->
        <HBox spacing="20" alignment="CENTER" styleClass="footer">
            <Label text="123 Health St, Wellness City" styleClass="footer-text"/>
            <Hyperlink fx:id="wantToKnowMoreLink" text="Go back" onAction="#goBackToWelcome"/>
        </HBox>
    </VBox>
</ScrollPane>