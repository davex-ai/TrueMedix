<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>
<?import javafx.scene.shape.Line?>
<ScrollPane fx:id="scrollPane" fitToWidth="true" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.project.hospitalmanagementsystem.controller.hospital.AboutUsController">
    <VBox alignment="TOP_CENTER" spacing="30" styleClass="main-container">
        <VBox.margin>
            <Insets top="40.0"/>
        </VBox.margin>

        <stylesheets>
            <URL value="@../../css/about.css"/>
        </stylesheets>

        <Label text="About Us" styleClass="page-title"/>

        <VBox spacing="10" alignment="CENTER">
            <Label text="🛤 Our Story" styleClass="section-heading"/>
            <Label text="At Trumedix, we began with a mission to make quality healthcare accessible and compassionate. Our journey combines innovation, empathy, and trust to deliver a seamless patient experience."
                   wrapText="true" styleClass="section-text"/>
        </VBox>

        <Line startX="0" endX="600" styleClass="section-line"/>

        <!-- Mission -->
        <VBox spacing="10" alignment="CENTER">
            <Label text="🎯 Mission" styleClass="section-heading"/>
            <Label text="Our mission is to provide outstanding medical services to all patients, combining modern technology with personalized care."
                   wrapText="true" styleClass="section-text"/>
        </VBox>

        <Line startX="0" endX="600" styleClass="section-line"/>

        <!-- Achievements -->
        <VBox spacing="10" alignment="CENTER">
            <Label text="🏆 Achievements" styleClass="section-heading"/>
            <FlowPane hgap="20" vgap="20" alignment="CENTER">
                <Button text="Opened 10 Clinics" styleClass="milestone-button"/>
                <Button text="Served 50K Patients" styleClass="milestone-button"/>
                <Button text="Top Healthcare Award 2025" styleClass="milestone-button"/>
            </FlowPane>
        </VBox>

        <Line startX="0" endX="600" styleClass="section-line"/>

        <!-- Founders Section -->
        <VBox spacing="10" alignment="CENTER">
            <Label text="👥 Founders" styleClass="section-heading"/>
            <FlowPane hgap="20" vgap="20" alignment="CENTER">
                <VBox spacing="5" alignment="CENTER">
                    <ImageView fitWidth="80" fitHeight="80" preserveRatio="true">
                        <image>
                            <Image url="https://via.placeholder.com/80" />
                        </image>
                    </ImageView>
                    <Label text="Dr. Mycah James" styleClass="section-text"/>
                    <Label text="CEO &amp; Founder" styleClass="subsection-text"/>
                </VBox>
                <VBox spacing="5" alignment="CENTER">
                    <ImageView fitWidth="80" fitHeight="80" preserveRatio="true">
                        <image>
                            <Image url="https://via.placeholder.com/80" />
                        </image>
                    </ImageView>
                    <Label text="Dr. Ayra Stark" styleClass="section-text"/>
                    <Label text="CTO &amp; Co-Founder" styleClass="subsection-text"/>
                </VBox>
                <VBox spacing="5" alignment="CENTER">
                    <ImageView fitWidth="80" fitHeight="80" preserveRatio="true">
                        <image>
                            <Image url="https://via.placeholder.com/80" />
                        </image>
                    </ImageView>
                    <Label text="Dr. Braun BlackWaters" styleClass="section-text"/>
                    <Label text="COO &amp; Co-Founder" styleClass="subsection-text"/>
                </VBox>
            </FlowPane>
        </VBox>

        <Line startX="0" endX="600" styleClass="section-line"/>

        <!-- Contact Section -->
        <VBox spacing="10" alignment="CENTER">
            <Label text="📞 Contact Us" styleClass="section-heading"/>
            <Label text="We're here to help anytime. Call, email, or visit our main office—our team is ready to guide you with care." wrapText="true" styleClass="section-text"/>
            <Label text="Phone: (+234) 123 456 7890" styleClass="section-text"/>
            <Label text="Email: support@trumedixcare.com" styleClass="section-text"/>
            <Label text="Address: 123 Health St, Wellness City" styleClass="section-text"/>
        </VBox>

        <!-- Footer -->
        <HBox spacing="20" alignment="CENTER" styleClass="footer">
            <Label text="© 2026 Trumedix" styleClass="footer-text"/>
            <Hyperlink fx:id="wantToKnowMoreLink" text="Go back" onAction="#goBackToWelcome"/>
        </HBox>
    </VBox>
</ScrollPane>