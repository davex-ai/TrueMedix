<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.project.hospitalmanagementsystem.controller.admin.EditPatientController"
            prefWidth="520"
            style="-fx-background-color: #f0f4f8;">

    <top>
        <VBox style="-fx-background-color: #1a2e4a; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 8, 0, 0, 2);">
            <padding><Insets top="18" right="24" bottom="18" left="24"/></padding>
            <Label text="Edit Patient"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #ffffff; -fx-font-family: 'Segoe UI';" />
            <Label text="Update patient information below."
                   style="-fx-font-size: 12px; -fx-text-fill: #90aac8; -fx-font-family: 'Segoe UI';" />
        </VBox>
    </top>

    <center>
        <VBox spacing="14">
            <padding><Insets top="24" right="24" bottom="10" left="24"/></padding>
            <VBox spacing="5">
                <Label text="Full Name" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #3d5a73; -fx-font-family: 'Segoe UI';"/>
                <TextField fx:id="nameField"
                           style="-fx-font-size: 13px; -fx-background-color: white; -fx-border-color: #d0dae6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 12 9 12; -fx-font-family: 'Segoe UI';"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Email Address" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #3d5a73; -fx-font-family: 'Segoe UI';"/>
                <TextField fx:id="emailField"
                           style="-fx-font-size: 13px; -fx-background-color: white; -fx-border-color: #d0dae6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 12 9 12; -fx-font-family: 'Segoe UI';"/>
            </VBox>

            <HBox spacing="14">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Gender" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #3d5a73; -fx-font-family: 'Segoe UI';"/>
                    <ComboBox fx:id="genderCombo" maxWidth="Infinity"
                              style="-fx-font-size: 13px; -fx-background-color: white; -fx-border-color: #d0dae6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-family: 'Segoe UI';"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Date of Birth" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #3d5a73; -fx-font-family: 'Segoe UI';"/>
                    <DatePicker fx:id="dobPicker" maxWidth="Infinity"
                                style="-fx-font-size: 13px; -fx-background-color: white; -fx-border-color: #d0dae6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-family: 'Segoe UI';"/>
                </VBox>
            </HBox>

            <VBox spacing="5">
                <Label text="Address" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #3d5a73; -fx-font-family: 'Segoe UI';"/>
                <TextArea fx:id="addressArea" prefRowCount="2" wrapText="true"
                          style="-fx-font-size: 13px; -fx-background-color: white; -fx-border-color: #d0dae6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 12 9 12; -fx-font-family: 'Segoe UI';"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Status" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #3d5a73; -fx-font-family: 'Segoe UI';"/>
                <ComboBox fx:id="statusCombo" maxWidth="Infinity"
                          style="-fx-font-size: 13px; -fx-background-color: white; -fx-border-color: #d0dae6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-family: 'Segoe UI';"/>
            </VBox>

            <Label fx:id="errorLabel" text=""
                   style="-fx-font-size: 12px; -fx-text-fill: #b03030; -fx-font-family: 'Segoe UI';" wrapText="true"/>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT"
              style="-fx-background-color: white; -fx-border-color: #e4eaf0 transparent transparent transparent; -fx-padding: 14 24 14 24;">
            <Button text="Cancel" onAction="#onCancel"
                    style="-fx-background-color: #f0f4f8; -fx-text-fill: #3d5a73; -fx-font-size: 13px; -fx-cursor: hand; -fx-border-color: #d0dae6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 20 8 20; -fx-font-family: 'Segoe UI';" />
            <Button text="Save Changes" onAction="#onSave"
                    style="-fx-background-color: #1e77d4; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 20 8 20; -fx-font-family: 'Segoe UI';" />
        </HBox>
    </bottom>

</BorderPane>
