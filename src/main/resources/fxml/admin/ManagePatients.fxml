<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.project.hospitalmanagementsystem.controller.admin.ManagePatientsController"
            prefWidth="1100" prefHeight="700"
            style="-fx-background-color: #f0f4f8;">

    <!-- ═══════════════════════════════════════════
         TOP: Page Header
    ═══════════════════════════════════════════ -->
    <top>
        <VBox style="-fx-background-color: #1a2e4a; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 8, 0, 0, 2);">
            <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <!-- Title Group -->
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Manage Patients"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #ffffff; -fx-font-family: 'Segoe UI';" />
                </VBox>
                </HBox>
        </VBox>
    </top>

    <!-- ═══════════════════════════════════════════
         CENTER: Toolbar + Table + Pagination
    ═══════════════════════════════════════════ -->
    <center>
        <VBox spacing="0">
            <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

            <!-- ── Stats Bar ── -->
            <HBox spacing="14" style="-fx-padding: 0 0 18 0;">
                <VBox fx:id="statTotalCard" alignment="CENTER" spacing="4" prefWidth="160"
                      style="-fx-background-color: white; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14 18 14 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                    <Label text="Total Patients" style="-fx-font-size: 12px; -fx-text-fill: #7a8fa6; -fx-font-family: 'Segoe UI';"/>
                    <Label fx:id="totalCountLabel" text="—" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a2e4a; -fx-font-family: 'Segoe UI';"/>
                </VBox>
                <VBox fx:id="statMaleCard" alignment="CENTER" spacing="4" prefWidth="160"
                      style="-fx-background-color: white; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14 18 14 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                    <Label text="Male" style="-fx-font-size: 12px; -fx-text-fill: #7a8fa6; -fx-font-family: 'Segoe UI';"/>
                    <Label fx:id="maleCountLabel" text="—" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1e77d4; -fx-font-family: 'Segoe UI';"/>
                </VBox>
                <VBox fx:id="statFemaleCard" alignment="CENTER" spacing="4" prefWidth="160"
                      style="-fx-background-color: white; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14 18 14 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                    <Label text="Female" style="-fx-font-size: 12px; -fx-text-fill: #7a8fa6; -fx-font-family: 'Segoe UI';"/>
                    <Label fx:id="femaleCountLabel" text="—" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #e0567a; -fx-font-family: 'Segoe UI';"/>
                </VBox>
            </HBox>

            <!-- ── Toolbar: Search + Filters + Buttons ── -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12 16 12 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">

                <!-- Search -->
                <TextField fx:id="searchField"
                           promptText="🔍  Search by name or email..."
                           prefWidth="260"
                           style="-fx-font-size: 13px; -fx-background-color: #f0f4f8; -fx-border-color: transparent; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12 8 12; -fx-font-family: 'Segoe UI';" />

                <!-- Gender Filter -->
                <ComboBox fx:id="genderFilter"
                          promptText="Gender ▾"
                          prefWidth="130"
                          style="-fx-font-size: 13px; -fx-background-color: #f0f4f8; -fx-border-color: transparent; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-family: 'Segoe UI';" />

                <!-- Status Filter -->
                <ComboBox fx:id="statusFilter"
                          promptText="Status ▾"
                          prefWidth="130"
                          style="-fx-font-size: 13px; -fx-background-color: #f0f4f8; -fx-border-color: transparent; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-family: 'Segoe UI';" />

                <!-- Spacer -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- Refresh Button -->
                <Button text="↻  Refresh" onAction="#refreshPatients"
                        style="-fx-background-color: #f0f4f8; -fx-text-fill: #3d5a73; -fx-font-size: 13px; -fx-cursor: hand; -fx-border-color: #d0dae6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 16 8 16; -fx-font-family: 'Segoe UI';" />
            </HBox>

            <!-- ── Spacer ── -->
            <Region prefHeight="14"/>

            <!-- ── Patient TableView ── -->
            <TableView fx:id="patientsTable"
                       VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-border-color: transparent; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2); -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;">

                <columns>
                    <TableColumn fx:id="colId"     text="Patient ID" prefWidth="95"  />
                    <TableColumn fx:id="colName"   text="Name"        prefWidth="170" />
                    <TableColumn fx:id="colGender" text="Gender"      prefWidth="90"  />
                    <TableColumn fx:id="colDob"    text="Date of Birth" prefWidth="120"/>
                    <TableColumn fx:id="colEmail"  text="Email"       prefWidth="200" />
                    <TableColumn fx:id="colAddress" text="Address"    prefWidth="190" />
                    <TableColumn fx:id="colStatus" text="Status"      prefWidth="90"  />
                    <TableColumn fx:id="colActions" text="Actions"    prefWidth="180" />
                </columns>

                <placeholder>
                    <Label text="No patients found."
                           style="-fx-font-size: 14px; -fx-text-fill: #9ab0c4; -fx-font-family: 'Segoe UI';" />
                </placeholder>
            </TableView>

            <!-- ── Pagination ── -->
            <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 12 0 0 0;">
                <Label fx:id="paginationInfoLabel"
                       text="Showing 0 records"
                       style="-fx-font-size: 12px; -fx-text-fill: #7a8fa6; -fx-font-family: 'Segoe UI';" />
                <Region HBox.hgrow="ALWAYS"/>
                <Pagination fx:id="pagination" pageCount="1" currentPageIndex="0"
                            style="-fx-page-information-visible: false;" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
