<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.project.hospitalmanagementsystem.controller.users.DepartmentView"
            prefWidth="1200" prefHeight="820"
            style="-fx-background-color: #f4f7fb;">

    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #1a6fbd, #2aa4d5);
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.20), 8, 0, 0, 2);">
            <padding><Insets top="22" right="36" bottom="22" left="36"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="14">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label fx:id="nameLabel" text="—"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: 'Segoe UI';"/>
                    <Label fx:id="descriptionLabel" text=""  wrapText="true"
                           style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.78); -fx-font-family: 'Segoe UI';"/>
                    <HBox spacing="20" style="-fx-padding: 6 0 0 0;">
                        <Label fx:id="hoursLabel" text=""
                               style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.65); -fx-font-family: 'Segoe UI';"/>
                        <Label fx:id="slotsLabel" text=""
                               style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.65); -fx-font-family: 'Segoe UI';"/>
                        <Label fx:id="statusLabel" text=""
                               style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.65); -fx-font-family: 'Segoe UI';"/>
                    </HBox>
                </VBox>
                <Button text="Book Appointment" onMouseClicked="#handleBookAppointment"
                        style="-fx-background-color: white; -fx-text-fill: #1a6fbd; -fx-font-size: 13px;
                               -fx-font-weight: bold; -fx-cursor: hand; -fx-border-radius: 8;
                               -fx-background-radius: 8; -fx-padding: 9 20 9 20; -fx-font-family: 'Segoe UI';"/>
                <Button text="← Back" onAction="#handleBack"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.30);
                               -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 9 18 9 18;
                               -fx-font-family: 'Segoe UI';"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox spacing="0">
                <padding><Insets top="28" right="36" bottom="36" left="36"/></padding>

                <HBox spacing="20">

                    <VBox spacing="20" HBox.hgrow="ALWAYS">

                        <VBox spacing="12"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                            <Label text="Our Doctors"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a2e4a; -fx-font-family: 'Segoe UI';"/>
                            <Label fx:id="doctorCountLabel" text=""
                                   style="-fx-font-size: 12px; -fx-text-fill: #7a8fa6; -fx-font-family: 'Segoe UI';"/>
                            <ScrollPane fitToWidth="true" prefHeight="320"
                                        style="-fx-background-color: transparent; -fx-border-color: transparent;">
                                <VBox fx:id="doctorContainer" spacing="12"/>
                            </ScrollPane>
                        </VBox>

                    </VBox>

                    <VBox spacing="20" prefWidth="320">

                        <VBox spacing="12"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                            <Label text="Available Services"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a2e4a; -fx-font-family: 'Segoe UI';"/>
                            <VBox fx:id="servicesContainer" spacing="8"/>
                        </VBox>

                        <VBox spacing="12"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                            <Label text="Quick Stats"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a2e4a; -fx-font-family: 'Segoe UI';"/>
                            <HBox spacing="14">
                                <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #eaf2fb; -fx-background-radius: 10; -fx-padding: 12 10 12 10;">
                                    <Label fx:id="statDoctorsLabel" text="—"
                                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a6fbd; -fx-font-family: 'Segoe UI';"/>
                                    <Label text="Doctors" style="-fx-font-size: 11px; -fx-text-fill: #3d5a73; -fx-font-family: 'Segoe UI';"/>
                                </VBox>
                                <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #eaf6ef; -fx-background-radius: 10; -fx-padding: 12 10 12 10;">
                                    <Label fx:id="statSlotsLabel" text="—"
                                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a7a45; -fx-font-family: 'Segoe UI';"/>
                                    <Label text="Slots" style="-fx-font-size: 11px; -fx-text-fill: #3d5a73; -fx-font-family: 'Segoe UI';"/>
                                </VBox>
                                <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #fef6e4; -fx-background-radius: 10; -fx-padding: 12 10 12 10;">
                                    <Label fx:id="statServicesLabel" text="—"
                                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #c47e0a; -fx-font-family: 'Segoe UI';"/>
                                    <Label text="Services" style="-fx-font-size: 11px; -fx-text-fill: #3d5a73; -fx-font-family: 'Segoe UI';"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <Button text="📋  Book an Appointment" onMouseClicked="#handleBookAppointment"
                                maxWidth="Infinity"
                                style="-fx-background-color: #1a6fbd; -fx-text-fill: white; -fx-font-size: 14px;
                                       -fx-font-weight: bold; -fx-cursor: hand; -fx-border-radius: 10;
                                       -fx-background-radius: 10; -fx-padding: 14 20 14 20; -fx-font-family: 'Segoe UI';"/>

                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
