<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.project.hospitalmanagementsystem.controller.users.homepage"
            prefWidth="1200" prefHeight="820"
            style="-fx-background-color: #f4f7fb;">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="0"
              style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 8, 0, 0, 2); -fx-padding: 0 32 0 32;">

            <Label text="Trumedix"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a6fbd; -fx-font-family: 'Segoe UI'; -fx-padding: 18 0 18 0;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="32" alignment="CENTER" style="-fx-padding: 0 32 0 32;">
                <Label text="Book Appointment" onMouseClicked="#handleBookAppointment"
                       style="-fx-font-size: 13px; -fx-text-fill: #3d5a73; -fx-cursor: hand; -fx-font-family: 'Segoe UI'; -fx-padding: 20 0 20 0;"/>
                <Label text="Departments" onMouseClicked="#handleDepartmentPage"
                       style="-fx-font-size: 13px; -fx-text-fill: #3d5a73; -fx-cursor: hand; -fx-font-family: 'Segoe UI'; -fx-padding: 20 0 20 0;"/>
                <Label text="Complaint" onMouseClicked="#handleComplaintPage"
                       style="-fx-font-size: 13px; -fx-text-fill: #3d5a73; -fx-cursor: hand; -fx-font-family: 'Segoe UI'; -fx-padding: 20 0 20 0;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="14" alignment="CENTER">
                <MenuButton fx:id="bellBtn"
                            style="-fx-background-color: #f0f4f8; -fx-border-color: transparent; -fx-background-radius: 20; -fx-cursor: hand; -fx-font-size: 16px; -fx-padding: 8 12 8 12;" text="🔔"/>
                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label fx:id="usernameLabel" text="—"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a2e4a; -fx-font-family: 'Segoe UI';"/>
                    <Label text="Patient"
                           style="-fx-font-size: 11px; -fx-text-fill: #7a8fa6; -fx-font-family: 'Segoe UI';"/>
                </VBox>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox spacing="0">
                <padding><Insets top="0" right="0" bottom="0" left="0"/></padding>


                <VBox alignment="CENTER_LEFT"
                      style="-fx-background-color: linear-gradient(to right, #1a6fbd, #2aa4d5); -fx-padding: 36 48 36 48;">
                    <Label fx:id="welcomeLabel" text="Welcome back"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: 'Segoe UI';"/>
                    <Label fx:id="greetingLabel" text=""
                           style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.80); -fx-font-family: 'Segoe UI'; -fx-padding: 4 0 0 0;"/>
                    <Label fx:id="dateLabel" text=""
                           style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.65); -fx-font-family: 'Segoe UI'; -fx-padding: 2 0 0 0;"/>
                </VBox>


                <VBox spacing="0" style="-fx-padding: 28 36 36 36;">


                    <HBox spacing="16" style="-fx-padding: 0 0 24 0;">
                        <VBox alignment="CENTER" spacing="4" prefWidth="180"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18 20 18 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                            <Label text="Total Appointments" style="-fx-font-size: 11px; -fx-text-fill: #7a8fa6; -fx-font-family: 'Segoe UI';"/>
                            <Label fx:id="statTotalLabel" text="—" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a2e4a; -fx-font-family: 'Segoe UI';"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="4" prefWidth="180"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18 20 18 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                            <Label text="Upcoming" style="-fx-font-size: 11px; -fx-text-fill: #7a8fa6; -fx-font-family: 'Segoe UI';"/>
                            <Label fx:id="statUpcomingLabel" text="—" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a6fbd; -fx-font-family: 'Segoe UI';"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="4" prefWidth="180"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18 20 18 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                            <Label text="Completed" style="-fx-font-size: 11px; -fx-text-fill: #7a8fa6; -fx-font-family: 'Segoe UI';"/>
                            <Label fx:id="statCompletedLabel" text="—" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a7a45; -fx-font-family: 'Segoe UI';"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="4" prefWidth="180"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18 20 18 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                            <Label text="Pending" style="-fx-font-size: 11px; -fx-text-fill: #7a8fa6; -fx-font-family: 'Segoe UI';"/>
                            <Label fx:id="statPendingLabel" text="—" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #c47e0a; -fx-font-family: 'Segoe UI';"/>
                        </VBox>
                    </HBox>


                    <HBox spacing="20" VBox.vgrow="ALWAYS">


                        <VBox spacing="14" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="Your Appointments"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a2e4a; -fx-font-family: 'Segoe UI';"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="+ Book New" onAction="#handleBookAppointmentBtn"
                                        style="-fx-background-color: #1a6fbd; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 7 16 7 16; -fx-font-family: 'Segoe UI';"/>
                            </HBox>

                            <VBox fx:id="appointmentsContainer" spacing="10"
                                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                                <Label fx:id="noAppointmentsLabel" text="No appointments found."
                                       style="-fx-font-size: 13px; -fx-text-fill: #9ab0c4; -fx-font-family: 'Segoe UI'; -fx-padding: 20 0 20 0;" visible="false" managed="false"/>
                            </VBox>
                        </VBox>


                        <VBox spacing="14" prefWidth="310">


                            <VBox spacing="8"
                                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18 20 18 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                                <Label text="🧠  Tip of the Day"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a6fbd; -fx-font-family: 'Segoe UI';"/>
                                <Label fx:id="tipLabel" text="" wrapText="true"
                                       style="-fx-font-size: 13px; -fx-text-fill: #3d5a73; -fx-font-family: 'Segoe UI';"/>
                            </VBox>


                            <VBox spacing="8"
                                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18 20 18 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                                <Label text="⏰  Reminder"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #c47e0a; -fx-font-family: 'Segoe UI';"/>
                                <Label fx:id="reminder" text="" wrapText="true"
                                       style="-fx-font-size: 13px; -fx-text-fill: #3d5a73; -fx-font-family: 'Segoe UI';"/>
                            </VBox>


                            <VBox spacing="8"
                                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18 20 18 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                                <Label text="📅  Next Appointment"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a7a45; -fx-font-family: 'Segoe UI';"/>
                                <Label fx:id="nextAppointmentLabel" text="—" wrapText="true"
                                       style="-fx-font-size: 13px; -fx-text-fill: #3d5a73; -fx-font-family: 'Segoe UI';"/>
                            </VBox>


                            <VBox spacing="10"
                                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18 20 18 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 6, 0, 0, 2);">
                                <Label text="Quick Actions"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a2e4a; -fx-font-family: 'Segoe UI';"/>
                                <Button text="📋  Book Appointment" onAction="#handleBookAppointmentBtn" maxWidth="Infinity"
                                        style="-fx-background-color: #eaf2fb; -fx-text-fill: #1a6fbd; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 14 9 14; -fx-font-family: 'Segoe UI'; -fx-alignment: CENTER_LEFT;"/>
                                <Button text="🏥  View Departments" onAction="#handleDepartmentBtn" maxWidth="Infinity"
                                        style="-fx-background-color: #eaf6ef; -fx-text-fill: #1a7a45; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 14 9 14; -fx-font-family: 'Segoe UI'; -fx-alignment: CENTER_LEFT;"/>
                                <Button text="📝  File a Complaint" onAction="#handleComplaintBtn" maxWidth="Infinity"
                                        style="-fx-background-color: #fef6e4; -fx-text-fill: #c47e0a; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 14 9 14; -fx-font-family: 'Segoe UI'; -fx-alignment: CENTER_LEFT;"/>
                            </VBox>

                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
